---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Project ARQ – Work In Progress" showFooter={false}>
    <div class="wip-page">

        <div class="wip-page__main" id="wip-placeholder">

            <section class="section wip-page__content">
                <!-- Top Star Divider -->
                <div class="wip-page__divider" aria-hidden="true">
                    <span class="wip-page__star">★</span>
                    <span class="wip-page__star">★</span>
                    <span class="wip-page__star">★</span>
                </div>

                <!-- Main Heading -->
                <h1 class="wip-page__title">Work in<br>Progress</h1>

                <!-- Subtitle -->
                <p class="wip-page__description">
                    I'm making lots of improvements and will be back soon.
                </p>

                <!-- Action Link -->
                <a href="index.html" class="btn btn--primary wip-page__cta">
                    Back to Home
                </a>
            </section>

        </div>

    </div>
</Layout>