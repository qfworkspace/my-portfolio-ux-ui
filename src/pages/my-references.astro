---
import Layout from '../layouts/Layout.astro';
---

<Layout 
title="My references" 
bodyClass="references-page" 
mainClass="references-page__main">


    <section class="section reference">
        <img 
        src="/asset/images/bg-references.png" 
        alt="" 
        aria-hidden="true" 
        class="references-page__bg" 
        />

        <div class="reference-container">
            <div class="reference-card">
                <div class="reference-card__profile">
                    <img src="/asset/images/profile-picture-person.png" alt="" class="reference-card__profile-picture">
                    <p class="reference-card__name"><b>Ref1 LAST NAME</b></p>
                    <p class="reference-card__position"><i>Faucibus arcu odio ultrices tincidunt a purus vestibulum.</i></p>
                </div>

                <div class="reference-card__body">
                    <blockquote class="reference-quote">
                        <p class="reference-quote__text">«​​​​​​​ Lorem ipsum dolor sit amet consectetur. Tristique dui phasellus viverra eget sed. Id id volutpat et tellus hac vestibulum vestibulum nunc. »</p>
                        <p class="reference-quote__text reference-quote__text--desktop">«​​​​​​​ Tristique dui phasellus viverra eget sed. Id id volutpat et tellus hac vestibulum vestibulum nunc. Tempor sed eget id non aliquam. »</p>
                    </blockquote>

                    <div class="reference-pdf__container">
                        <a href="/pdf" class="button reference-pdf-button">Read more</a>
                    </div>
                </div>
            </div>

            <div class="reference-card">
                <div class="reference-card__profile">
                    <img src="/asset/images/profile-picture-person.png" alt="" class="reference-card__profile-picture">
                    <p class="reference-card__name"><b>Ref2 LAST NAME</b></p>
                    <p class="reference-card__position"><i>Faucibus arcu odio ultrices tincidunt a purus vestibulum.</i></p>
                </div>

                <div class="reference-card__body">
                    <blockquote class="reference-quote">
                        <p class="reference-quote__text">«​​​​​​​ Lorem ipsum dolor sit amet consectetur. Tristique dui phasellus viverra eget sed. Id id volutpat et tellus hac vestibulum vestibulum nunc. »</p>
                        <p class="reference-quote__text reference-quote__text--desktop">«​​​​​​​ Tristique dui phasellus viverra eget sed. Id id volutpat et tellus hac vestibulum vestibulum nunc. Tempor sed eget id non aliquam. »</p>
                    </blockquote>

                    <div class="reference-pdf__container">
                        <a href="/pdf" class="button reference-pdf-button">Read more</a>
                    </div>
                </div>
            </div>

            <div class="reference-card">
                <div class="reference-card__profile">
                    <img src="/asset/images/profile-picture-person.png" alt="" class="reference-card__profile-picture">
                    <p class="reference-card__name"><b>Ref3 LAST NAME</b></p>
                    <p class="reference-card__position"><i>Faucibus arcu odio ultrices tincidunt a purus vestibulum.</i></p>
                </div>

                <div class="reference-card__body">
                    <blockquote class="reference-quote">
                        <p class="reference-quote__text">«​​​​​​​ Lorem ipsum dolor sit amet consectetur. Tristique dui phasellus viverra eget sed. Id id volutpat et tellus hac vestibulum vestibulum nunc. »</p>
                        <p class="reference-quote__text reference-quote__text--desktop">«​​​​​​​ Tristique dui phasellus viverra eget sed. Id id volutpat et tellus hac vestibulum vestibulum nunc. Tempor sed eget id non aliquam. »</p>
                    </blockquote>

                    <div class="reference-pdf__container">
                        <a href="/pdf" class="button reference-pdf-button">Read more</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="expertise-carousel__controls">
            <button type="button" class="expertise-carousel__btn expertise-carousel__btn--prev" aria-label="Previous reference">←</button>
            <button type="button" class="expertise-carousel__btn expertise-carousel__btn--next" aria-label="Next reference">→</button>
        </div>
    </section>

</Layout>

<script>
    const track = document.querySelector('.reference-container') as HTMLElement;
    const prevBtn = document.querySelector('.expertise-carousel__btn--prev');
    const nextBtn = document.querySelector('.expertise-carousel__btn--next');

    if (track) {
        const originalCards = Array.from(track.querySelectorAll('.reference-card')) as HTMLElement[];
        const count = originalCards.length;

        if (count > 1) {
            // Duplique l'ensemble des cartes avant et après pour créer 3 cycles : [Avants] [Milieu] [Après]
            const beforeFragment = document.createDocumentFragment();
            const afterFragment = document.createDocumentFragment();

            originalCards.forEach((card) => {
                const cloneBefore = card.cloneNode(true) as HTMLElement;
                const cloneAfter = card.cloneNode(true) as HTMLElement;
                cloneBefore.setAttribute('aria-hidden', 'true');
                cloneAfter.setAttribute('aria-hidden', 'true');
                beforeFragment.appendChild(cloneBefore);
                afterFragment.appendChild(cloneAfter);
            });

            track.insertBefore(beforeFragment, originalCards[0]);
            track.appendChild(afterFragment);

            const allCards = Array.from(track.querySelectorAll('.reference-card')) as HTMLElement[];

            // Calcule la largeur d'un cycle complet (cartes + gaps)
            function getSetWidth() {
                return allCards[count].offsetLeft - allCards[0].offsetLeft;
            }

            // Place immédiatement le scroll sur la 1re carte du bloc central
            function initPosition() {
                const setWidth = getSetWidth();
                track.style.scrollBehavior = 'auto';
                track.scrollLeft = setWidth;
            }

            // Recale silencieusement vers le bloc central dès qu'on entre dans un bloc clone
            let scrollTimeout: number;
            track.addEventListener('scroll', () => {
                clearTimeout(scrollTimeout);
                scrollTimeout = window.setTimeout(() => {
                    const setWidth = getSetWidth();
                    if (track.scrollLeft < setWidth * 0.5) {
                        track.style.scrollBehavior = 'auto';
                        track.scrollLeft += setWidth;
                    } else if (track.scrollLeft >= setWidth * 1.5) {
                        track.style.scrollBehavior = 'auto';
                        track.scrollLeft -= setWidth;
                    }
                }, 80);
            });

            // Navigation par flèches (d'une carte à la fois)
            function scrollByCard(direction: number) {
                const gap = parseFloat(getComputedStyle(track).gap) || 0;
                const step = allCards[0].offsetWidth + gap;
                track.scrollBy({
                    left: direction * step,
                    behavior: 'smooth',
                });
            }

            prevBtn?.addEventListener('click', () => scrollByCard(-1));
            nextBtn?.addEventListener('click', () => scrollByCard(1));

            window.addEventListener('resize', initPosition);
            requestAnimationFrame(initPosition);
        }
    }
</script>