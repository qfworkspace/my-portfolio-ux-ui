</Layout>

<script>
    // 1. Carrousel des domaines d'expertise
    const track = document.querySelector<HTMLElement>('.authors-expertise__card-container');
    const prevBtn = document.querySelector<HTMLButtonElement>('.expertise-carousel__btn--prev');
    const nextBtn = document.querySelector<HTMLButtonElement>('.expertise-carousel__btn--next');

    if (track && prevBtn && nextBtn) {
        const getScrollStep = () => {
            const card = track.querySelector<HTMLElement>('.authors-expertise__expertise-card');
            return card ? card.offsetWidth : 300;
        };

        nextBtn.addEventListener('click', () => {
            track.scrollBy({ left: getScrollStep(), behavior: 'smooth' });
        });

        prevBtn.addEventListener('click', () => {
            track.scrollBy({ left: -getScrollStep(), behavior: 'smooth' });
        });
    }

    // 2. Sauvegarde automatique des champs du formulaire contre le refresh accidentel
    function enableFormAutoSave(formSelector: string, storageKey: string) {
        const form = document.querySelector<HTMLFormElement>(formSelector);
        if (!form) return;

        const fields = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[name], textarea[name]');

        const savedData = sessionStorage.getItem(storageKey);
        if (savedData) {
            const parsedData = JSON.parse(savedData) as Record<string, string>;
            fields.forEach((field) => {
                if (parsedData[field.name]) {
                    field.value = parsedData[field.name];
                }
            });
        }

        form.addEventListener('input', () => {
            const currentData: Record<string, string> = {};
            fields.forEach((field) => {
                currentData[field.name] = field.value;
            });
            sessionStorage.setItem(storageKey, JSON.stringify(currentData));
        });
    }

    enableFormAutoSave('.about-form', 'draft_about_form');

    // 3. Envoi du formulaire latéral "Let's discuss" via Web3Forms
    const aboutForm = document.querySelector<HTMLFormElement>('.about-form');

    aboutForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const form = e.target as HTMLFormElement;
        const submitBtn = form.querySelector<HTMLButtonElement>('.form-submit-button');
        if (!submitBtn) return;

        const formData = new FormData(form);
        formData.append("access_key", "2a0c508c-1835-40ac-a4eb-1b85b08729ab");
        formData.append("from_name", `My portfolio – ${formData.get("name")}`);
        formData.append("subject", "New contact request – About Page");

        const originalBtnText = submitBtn.textContent;
        submitBtn.disabled = true;
        submitBtn.textContent = "Sending...";

        try {
            const response = await fetch("https://api.web3forms.com/submit", {
                method: "POST",
                body: formData
            });
            const data = await response.json();

            if (data.success) {
                submitBtn.textContent = "Contact sent!";
                form.reset();
                sessionStorage.removeItem('draft_about_form');
            } else {
                submitBtn.textContent = "Error, please try again";
            }
        } catch {
            submitBtn.textContent = "Network error";
        } finally {
            setTimeout(() => {
                submitBtn.disabled = false;
                submitBtn.textContent = originalBtnText;
            }, 3000);
        }
    });
</script>