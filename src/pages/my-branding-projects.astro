                        class="breadcrumb__link"
                        aria-current="page"> <!-- aria-current is an accessibility attribute defined by WAI-ARIA that informs screen readers and assistive technologies that an element represents the currently active page within a set of navigation links -->
                        My Branding Projects   
                        </span> 
                    </li>
                </ol>
            </nav>

